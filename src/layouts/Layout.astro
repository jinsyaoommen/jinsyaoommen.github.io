---
import Navigation from '../components/Navigation';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = "Jinsy Oommen - Product leader focused on thoughtful work, honest leadership, and building things that matter.",
  image = "/profile.jpg",
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Jinsy Oommen" />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:site_name" content="Jinsy Oommen" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="Jinsy Oommen | Reflections" href="/rss.xml" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <Navigation client:load />
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --site-ink: #292929;
    --site-muted: #646464;
    --site-hairline: #dedede;
    --site-accent: #536b79;
    --site-paper: #ffffff;
    --site-soft: #f8f8f8;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    min-height: 100vh;
    background: var(--site-paper);
    color: var(--site-ink);
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  a { transition: color .18s ease, opacity .18s ease; }
  a:focus-visible { outline: 2px solid var(--site-accent); outline-offset: 4px; }
  .editorial-site-header { border-bottom: 1px solid var(--site-hairline); background: white; }
  .editorial-nav-inner { max-width: 1180px; margin: 0 auto; padding: 1.5rem 2rem; display: flex; justify-content: space-between; align-items: center; gap: 2rem; }
  .editorial-brand { display: inline-flex; align-items: center; gap: .65rem; font-size: 1.06rem; font-weight: 600; letter-spacing: -.025em; color: var(--site-ink); text-decoration: none; white-space: nowrap; }
  .editorial-j { flex: 0 0 auto; overflow: visible; }
  .editorial-navigation { display: flex; align-items: center; gap: 2.3rem; }
  .editorial-navigation a { font-size: .87rem; color: #555; text-decoration: none; }
  .editorial-navigation a:hover { color: var(--site-ink); text-decoration: underline; text-underline-offset: 5px; }
  @media(max-width: 650px) {
    .editorial-nav-inner { padding: 1.25rem 1rem; flex-direction: column; gap: 1rem; }
    .editorial-navigation { gap: 1.5rem; }
  }
</style>

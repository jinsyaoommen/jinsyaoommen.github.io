---
import Layout from '../layouts/Layout.astro';

const paperUrl = 'https://www.aceee.org/proceedings/from-distributed-spreadsheets-to-one-platform-digitizing-sem-delivery-while-maintaining-performance-and-participant-experience/';
---

<Layout
  title="Resume | Jinsy Oommen"
  description="Jinsy Oommen's professional background, conference presentations, and published research in energy management and software product leadership."
>
  <section class="resume">
    <div class="container">
      <header class="intro">
        <p class="eyebrow">Professional Background</p>
        <h1>Resume</h1>
        <p class="lead">
          I lead the Gazebo software business at Cascade Energy, working across product strategy,
          engineering, and customer delivery. My work is focused on making energy management
          more accessible and scalable through software.
        </p>
      </header>

      <section class="section" aria-labelledby="experience-heading">
        <h2 id="experience-heading">Experience</h2>
        <div class="entry">
          <div class="entry-heading">
            <h3>Product Director, Gazebo</h3>
            <span class="year">Current</span>
          </div>
          <p class="organization">Cascade Energy</p>
          <p>
            Lead the Gazebo energy performance software business, including product strategy,
            software engineering, customer experience, delivery, and business performance.
          </p>
        </div>
      </section>

      <section class="section" aria-labelledby="speaking-heading">
        <h2 id="speaking-heading">Conference Speaking</h2>
        <div class="entry">
          <div class="entry-heading">
            <h3>ACEEE Summer Study on Energy Efficiency in Buildings</h3>
            <span class="year">2026</span>
          </div>
          <p class="organization">Pacific Grove, California</p>
          <p>
            Presented <em>From Distributed Spreadsheets to One Platform: Digitizing SEM Delivery
            While Maintaining Performance and Participant Experience</em>, covering the transition
            from spreadsheet-based Strategic Energy Management program delivery to a centralized
            software platform.
          </p>
          <a class="detail-link" href={paperUrl} target="_blank" rel="noopener noreferrer">
            Read published paper <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="entry">
          <div class="entry-heading">
            <h3>E Source Forum</h3>
            <span class="year">2026</span>
          </div>
          <p class="organization">Denver, Colorado</p>
          <p>
            Panelist alongside Laura Schaefer of Energy Trust of Oregon for
            <em>Great Expectations: Utility-Vendor Success Stories in Energy Efficiency and Electrification</em>.
            Discussed the use of Gazebo to simplify SEM program delivery and support ongoing energy management.
          </p>
          <a class="detail-link" href="https://www.esource.com/forum-2026" target="_blank" rel="noopener noreferrer">
            About the conference <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>

      <section class="section" aria-labelledby="publication-heading">
        <h2 id="publication-heading">Publication</h2>
        <div class="entry">
          <div class="entry-heading">
            <h3>
              <a href={paperUrl} target="_blank" rel="noopener noreferrer">
                From Distributed Spreadsheets to One Platform: Digitizing SEM Delivery While Maintaining Performance and Participant Experience
              </a>
            </h3>
            <span class="year">2026</span>
          </div>
          <p class="organization">Jinsy Oommen and Laura Schaefer</p>
          <p>ACEEE Summer Study on Energy Efficiency in Buildings, conference proceedings.</p>
          <a class="detail-link" href={paperUrl} target="_blank" rel="noopener noreferrer">
            View on ACEEE <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>

      <section class="section contact" aria-labelledby="connect-heading">
        <h2 id="connect-heading">Connect</h2>
        <p>
          You can find me on <a href="https://www.linkedin.com/in/jinsy-o-103b9a4/" target="_blank" rel="noopener noreferrer">LinkedIn</a>.
        </p>
      </section>
    </div>
  </section>
</Layout>

<style>
  .resume { padding: 4.5rem 0 6rem; min-height: calc(100vh - 64px); }
  .container { width: 100%; max-width: 820px; padding: 0 2rem; margin: 0 auto; }
  .intro { margin-bottom: 3rem; }
  .eyebrow { font-size: 0.76rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: #7c9eb2; margin-bottom: 0.75rem; }
  h1 { font-size: 2.5rem; font-weight: 600; letter-spacing: -0.025em; color: #2d2d2d; margin-bottom: 1.25rem; }
  .lead { font-size: 1.1rem; line-height: 1.8; color: #555; max-width: 680px; }
  .section { border-top: 1px solid #e7e7e7; padding-top: 2rem; margin-top: 2.5rem; }
  h2 { font-size: 1.25rem; font-weight: 600; margin-bottom: 1.5rem; color: #2d2d2d; }
  .entry + .entry { border-top: 1px solid #efefef; margin-top: 1.75rem; padding-top: 1.75rem; }
  .entry-heading { display: flex; gap: 1rem; justify-content: space-between; align-items: baseline; }
  h3 { font-size: 1.07rem; font-weight: 600; line-height: 1.5; color: #2d2d2d; }
  .year { font-size: 0.88rem; color: #888; white-space: nowrap; }
  .organization { color: #777; font-size: 0.91rem; margin: 0.35rem 0 0.8rem; }
  .entry > p:not(.organization), .contact p { line-height: 1.75; color: #555; font-size: 0.97rem; }
  a { color: #5b8096; text-decoration: none; }
  a:hover { text-decoration: underline; }
  .entry h3 a { color: inherit; }
  .detail-link { display: inline-block; margin-top: 0.85rem; font-size: 0.9rem; font-weight: 500; }
  @media (max-width: 600px) {
    .resume { padding: 3rem 0 4rem; }
    .container { padding: 0 1.25rem; }
    h1 { font-size: 2rem; }
    .entry-heading { flex-direction: column; gap: 0.2rem; }
  }
</style>

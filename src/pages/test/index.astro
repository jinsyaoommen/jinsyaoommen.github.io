---
import { getCollection } from 'astro:content';

const recentPosts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="description" content="A test of a more refined homepage design for The Good Oommen." />
    <title>Test | Jinsy Oommen</title>
    <link rel="icon" href="/favicon.png" />
  </head>
  <body>
    <div class="preview-bar">
      <span>DESIGN PREVIEW</span>
      <a href="/">Return to current homepage <span aria-hidden="true">↗</span></a>
    </div>
    <header class="site-header">
      <div class="header-inner">
        <a class="name" href="/" aria-label="Jinsy Oommen">
          <svg class="j-mark" viewBox="0 0 52 58" width="37" height="42" role="img" aria-label="Jeweled letter J">
            <defs>
              <linearGradient id="jMetal" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#ad7d38"/>
                <stop offset=".38" stop-color="#e7ce8c"/>
                <stop offset=".64" stop-color="#b88c41"/>
                <stop offset="1" stop-color="#f1deb0"/>
              </linearGradient>
            </defs>
            <path d="M17 8 H43" stroke="url(#jMetal)" stroke-width="2.3" stroke-linecap="round"/>
            <path d="M31 9 V37 C31 48 25 52 17 52 C10 52 6 49 5 43" fill="none" stroke="#324e57" stroke-width="5" stroke-linecap="round"/>
            <path d="M34 9 V37 C34 49 27 55 17 55 C9 55 4 51 2 44" fill="none" stroke="url(#jMetal)" stroke-width="1.3" stroke-linecap="round"/>
            <path d="M36 11 L42 5 L48 11 L42 17 Z" fill="#0c7182" stroke="#c49a55" stroke-width="1.4"/>
            <path d="M42 5 V17 M36 11 H48" stroke="#e8e5ce" stroke-width=".7" opacity=".8"/>
            <circle cx="11" cy="42" r="2.2" fill="#966caa" stroke="#cba76a" stroke-width="1"/>
            <circle cx="18" cy="54" r="1.7" fill="#2e8495"/>
          </svg>
          <span>Jinsy Oommen</span>
        </a>
        <nav aria-label="Main">
          <a href="/about">About</a>
          <a href="/reflections">Reflections</a>
          <a href="/favorites">Interests</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="hero-inner">
          <div class="hero-copy">
            <span class="eyebrow">Hi, I'm Jinsy</span>
            <h1>I care about thoughtful work, honest leadership, and building things that matter.</h1>
            <p>This is where I reflect on products, people, and the choices that shape both. At Cascade Energy, I work with teams to build products that help organizations create a culture of energy management and turn insight into action.</p>
            <a class="text-link" href="/reflections">Read My Reflections <span aria-hidden="true">↗</span></a>
          </div>
          <figure class="hero-photo">
            <img src="/profile.jpg" alt="Jinsy Oommen" width="550" height="430" fetchpriority="high" />
          </figure>
        </div>
      </section>

      {recentPosts.length > 0 && (
        <section class="writing" aria-label="Recent Reflections">
          <div class="writing-inner">
            <div class="section-intro">
              <h2>Recent Reflections</h2>
              <a href="/reflections">View All Reflections <span aria-hidden="true">↗</span></a>
            </div>
            <div class="post-list">
              {recentPosts.map((post) => (
                <a href={`/reflections/${post.id}`} class="post">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString('en-US', {month:'short',day:'numeric',year:'numeric'})}
                  </time>
                  <div>
                    <h3>{post.data.title}</h3>
                    <p>{post.data.description}</p>
                  </div>
                  <span class="arrow" aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          </div>
        </section>
      )}
    </main>
    <footer>
      <div class="footer-inner"><span>© {new Date().getFullYear()} Jinsy Oommen</span><span><a href="/about">About</a><a href="/reflections">Reflections</a><a href="/favorites">Interests</a></span></div>
    </footer>
  </body>
</html>
<style is:global>
  :root { --ink:#292929;--muted:#646464;--hairline:#dedede;--paper:#fff;--light:#f8f8f8;--accent:#536b79; }
  *{box-sizing:border-box}
  body{margin:0;background:var(--paper);color:var(--ink);font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;-webkit-font-smoothing:antialiased}
  a{color:inherit;text-decoration:none}
  a:focus-visible{outline:2px solid var(--accent);outline-offset:5px}
  .preview-bar{background:#f0f1f2;border-bottom:1px solid #dfe1e3;padding:.65rem max(1.3rem,calc((100vw - 1180px)/2));display:flex;justify-content:space-between;align-items:center;gap:1rem;color:#5c6367;font-size:.72rem}
  .preview-bar span:first-child{font-weight:600;letter-spacing:.1em}
  .preview-bar a{text-decoration:underline;text-underline-offset:3px}
  .site-header{border-bottom:1px solid var(--hairline);background:var(--paper)}
  .header-inner{max-width:1180px;margin:auto;padding:1.5rem 2rem;display:flex;justify-content:space-between;align-items:center;gap:2rem}
  .name{display:inline-flex;align-items:center;gap:.65rem;font-weight:600;letter-spacing:-.025em;font-size:1.06rem;white-space:nowrap}.j-mark{flex:0 0 auto;overflow:visible}
  nav{display:flex;gap:2.3rem;align-items:center}
  nav a{font-size:.87rem;color:#555;transition:color .2s}
  nav a:hover{color:var(--ink);text-decoration:underline;text-underline-offset:5px}
  .hero{background:var(--light)}
  .hero-inner{max-width:1180px;margin:auto;padding:1.8rem 2rem;display:grid;grid-template-columns:minmax(0,1fr) 150px;gap:3rem;align-items:center}
  .hero-copy{max-width:620px}
  .eyebrow{display:block;color:var(--accent);font-size:.8rem;letter-spacing:.05em;font-weight:600;margin:0 0 .5rem}
  .hero h1{font-family:Georgia,"Times New Roman",serif;font-size:clamp(1.35rem,2vw,1.8rem);line-height:1.32;letter-spacing:-.025em;font-weight:400;margin:0 0 .55rem}
  .hero p{font-size:.89rem;line-height:1.6;max-width:790px;color:var(--muted);margin:0}
  .text-link{display:inline-block;margin-top:.8rem;font-size:.83rem;color:#344b5b;padding-bottom:.2rem;border-bottom:1px solid #81929b}
  .text-link:hover{color:#171717;border-color:#171717}
  .text-link span{margin-left:.8rem}
  .hero-photo{margin:0;width:150px;height:150px;justify-self:end;overflow:hidden;background:#dedede;border-radius:3px}
  .hero-photo img{width:100%;height:100%;display:block;object-fit:cover;object-position:center}
  .writing{background:#fff}
  .writing-inner{max-width:1010px;padding:2rem 2rem 4rem;margin:auto}
  .section-intro{display:flex;align-items:end;justify-content:space-between;gap:2rem;margin-bottom:1.4rem}
  .section-intro h2{font-family:Georgia,"Times New Roman",serif;font-size:1.75rem;font-weight:400;letter-spacing:-.025em;margin:0}
  .section-intro>a{font-size:.85rem;color:#50616a;border-bottom:1px solid #aebac0;padding-bottom:.4rem}
  .post-list{border-top:1px solid var(--hairline)}
  .post{display:grid;grid-template-columns:115px minmax(0,1fr) 32px;gap:2rem;padding:1.25rem 0;border-bottom:1px solid var(--hairline);align-items:start}
  .post time{text-transform:uppercase;letter-spacing:.04em;font-size:.75rem;color:#7d7d7d;margin-top:.4rem}
  .post h3{font-size:1.12rem;letter-spacing:-.018em;font-weight:550;line-height:1.4;margin:0 0 .45rem}
  .post p{font-size:.89rem;line-height:1.65;color:#777;margin:0}
  .post .arrow{justify-self:end;color:#888;font-size:1.18rem;transition:transform .2s}
  .post:hover h3{color:#416171}
  .post:hover .arrow{transform:translate(2px,-2px);color:#416171}
  footer{background:#292929;color:#dedede}
  .footer-inner{max-width:1180px;margin:auto;padding:1.6rem 2rem;display:flex;justify-content:space-between;gap:2rem;align-items:center;font-size:.76rem}
  .footer-inner>span:last-child{display:flex;gap:1.3rem}
  @media(max-width:800px){.hero-inner{gap:1.8rem;grid-template-columns:minmax(0,1fr) 130px}.hero-photo{width:130px;height:130px}.hero h1{font-size:1.65rem}}
  @media(max-width:650px){.preview-bar{padding:.65rem 1rem}.header-inner{padding:1.25rem 1rem;flex-direction:column;gap:1rem}.header-inner nav{gap:1.5rem}.hero-inner{padding:1.7rem 1.25rem;display:grid;grid-template-columns:minmax(0,1fr) 96px;align-items:start;gap:1rem}.hero-photo{width:96px;height:112px;max-width:none;grid-column:2;grid-row:1}.hero-copy{grid-column:1;grid-row:1}.hero h1{font-size:1.32rem}.writing-inner{padding:2rem 1.25rem}.section-intro{align-items:start;flex-direction:column;gap:.7rem}.post{grid-template-columns:minmax(0,1fr) 24px;gap:.75rem;padding:1.45rem 0}.post time{grid-column:1/-1;margin:0}.post h3{font-size:1.07rem}.footer-inner{padding:1.6rem 1.25rem;align-items:start;flex-direction:column}}
  @media(prefers-reduced-motion:reduce){*,*:before,*:after{transition:none!important}}
</style>
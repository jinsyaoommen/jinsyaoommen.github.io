---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// SECRET - not linked anywhere, excluded from sitemap and search.
// Lists posts with `draft: true` in their frontmatter.
const drafts = (await getCollection('blog'))
  .filter((post) => post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Drafts | Jinsy Oommen" noindex>
  <section class="drafts">
    <div class="container">
      <h1>Drafts</h1>
      <p class="intro">Unpublished posts. Set <code>draft: false</code> to publish.</p>

      {drafts.length === 0 ? (
        <p class="empty">No drafts right now.</p>
      ) : (
        <ul>
          {drafts.map((post) => (
            <li>
              <a href={`/reflections/${post.id}/`}>{post.data.title}</a>
              <span class="date">
                {post.data.pubDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </span>
              <p>{post.data.description}</p>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</Layout>

<style>
  .drafts {
    padding: 4rem 0;
    min-height: calc(100vh - 64px);
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  h1 {
    font-size: 2.5rem;
    font-weight: 600;
    margin-bottom: 1rem;
    color: #2d2d2d;
  }

  .intro,
  .empty {
    color: #888;
    font-size: 0.95rem;
    margin-bottom: 2rem;
  }

  ul {
    list-style: none;
    padding: 0;
  }

  li {
    background: #f9f9f9;
    border-left: 3px solid #e6b800;
    padding: 1.25rem 1.5rem;
    margin-bottom: 1rem;
  }

  li a {
    color: #2d2d2d;
    font-weight: 600;
    text-decoration: none;
  }

  li a:hover {
    color: #7c9eb2;
  }

  .date {
    display: block;
    color: #888;
    font-size: 0.8rem;
    margin-top: 0.25rem;
  }

  li p {
    color: #666;
    font-size: 0.9rem;
    margin: 0.5rem 0 0;
  }
</style>

---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const recentPosts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const topics = [
  { title: 'About', description: 'Who I am, what I work on, and what keeps me curious.', href: '/about', label: 'Get to know me', image: '/Headshot.jpeg', alt: 'Portrait of Jinsy Oommen' },
  { title: 'Reflections', description: 'Thoughts on software, leadership, people, and everyday life.', href: '/reflections', label: 'Read my thoughts', image: '/places/kerala.jpg', alt: 'Landscape in Kerala' },
  { title: 'Interests', description: 'The people, places, and things I enjoy.', href: '/favorites', label: 'Explore my interests', image: '/places/mthood.jpg', alt: 'Mount Hood in Oregon' },
];
---

<Layout title="The Good Oommen | Jinsy Oommen" description="Jinsy Oommen on technology, people, leadership, and life.">
  <div class="home">
    <section class="hero">
      <div class="hero-inner">
        <div class="hero-copy">
          <span class="eyebrow">THE GOOD OOMMEN</span>
          <h1>Thoughts on <em>work, people,</em> and everything in between.</h1>
          <span class="gold-stroke" aria-hidden="true"></span>
          <p>I'm Jinsy. I lead a software business and write about what I learn along the way, at work, with people, and in life.</p>
          <a class="hero-link" href="/reflections">Read my reflections <span aria-hidden="true">↗</span></a>
        </div>
        <div class="hero-photo">
          <div class="wood-slat" aria-hidden="true"></div>
          <img src="/profile.jpg" alt="Jinsy Oommen" width="560" height="650" fetchpriority="high" />
          <span class="portrait-corner" aria-hidden="true"></span>
        </div>
      </div>
    </section>

    <section class="intro-strip" aria-label="About this space">
      <span class="woven-trim" aria-hidden="true"></span>
      <p>Part professional journal, part personal reflections.</p>
      <span class="woven-trim" aria-hidden="true"></span>
    </section>

    <section class="explore-section">
      <div class="topic-grid">
        {topics.map((topic) => (
          <a href={topic.href} class="topic-card">
            <div class="topic-photo"><img src={topic.image} alt={topic.alt} loading="lazy" /></div>
            <div class="topic-content">
              <h2>{topic.title}</h2>
              <p>{topic.description}</p>
              <span class="topic-link">{topic.label} <span aria-hidden="true">↗</span></span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="statement-section">
      <div class="statement-inner">
        <p>Building a business, leading people, and staying human is a constant work in progress.</p>
        <span class="gold-stroke" aria-hidden="true"></span>
        <a href="/reflections">Read more reflections <span aria-hidden="true">→</span></a>
      </div>
    </section>

    {recentPosts.length > 0 && (
      <section class="writing-section">
        <div class="writing-heading">
          <div>
            <span class="eyebrow">RECENT REFLECTIONS</span>
            <h2>Latest thoughts</h2>
          </div>
          <a href="/reflections">View all reflections <span aria-hidden="true">↗</span></a>
        </div>
        <div class="posts-grid">
          {recentPosts.map((post, index) => (
            <a href={`/reflections/${post.id}`} class="post-card">
              <div class={`post-art post-art-${index + 1}`} aria-hidden="true"><span>{String(index+1).padStart(2,'0')}</span></div>
              <span class="post-date">{post.data.pubDate.toLocaleDateString('en-US', { month:'long', day:'numeric', year:'numeric' })}</span>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <span class="post-link">Read reflection <span aria-hidden="true">↗</span></span>
            </a>
          ))}
        </div>
      </section>
    )}

    <footer class="site-footer">
      <div class="footer-main">
        <div><span class="footer-brand">The Good Oommen</span><p>Thoughts on work, people, and life.</p></div>
        <div class="footer-links"><a href="/about">About</a><a href="/reflections">Reflections</a><a href="/favorites">Interests</a></div>
      </div>
      <div class="footer-bottom"><small>© {new Date().getFullYear()} Jinsy Oommen</small><span class="footer-motif" aria-hidden="true"></span></div>
    </footer>
  </div>
</Layout>

<style>
  .home { --peacock:#14596a; --forest:#153c36; --ink:#1e3430; --paper:#f8f7f2; --brass:#ad8a49; --walnut:#76513c; color:var(--ink); background:var(--paper); }
  .home :is(h1,h2,h3) { font-family:Georgia,'Times New Roman',serif; font-weight:400; }
  .eyebrow { font-size:.74rem; letter-spacing:.22em; color:#9b722e; font-weight:700; }
  .hero { background:linear-gradient(105deg,#f8f7f2 0%,#f5f3ec 50%,#e8e3d8 100%); }
  .hero-inner { max-width:1350px; margin:0 auto; min-height:660px; display:grid; grid-template-columns:1fr .95fr; align-items:stretch; }
  .hero-copy { padding:5.2rem 2rem 5.5rem max(2.5rem,calc((100vw - 1250px)/2)); align-self:center; position:relative; z-index:1; }
  .hero-copy h1 { font-size:clamp(3.1rem,5.1vw,5.5rem); line-height:1.1; letter-spacing:-.04em; margin:1.6rem 0 1.6rem; max-width:660px; color:#103936; }
  .hero-copy h1 em { font-style:normal; color:var(--peacock); }
  .gold-stroke { display:block; width:48px; height:3px; background:var(--brass); }
  .hero-copy p { font-size:1.03rem; line-height:1.8; margin:1.3rem 0 1.6rem; max-width:440px; color:#35433d; }
  .hero-link { display:inline-flex; align-items:center; gap:2rem; color:#fff; background:var(--forest); padding:1rem 1.3rem; font-size:.85rem; text-decoration:none; }
  .hero-link:hover { background:var(--peacock); }
  .hero-photo { position:relative; overflow:hidden; background:#a89880; }
  .hero-photo img { display:block; width:100%; height:100%; min-height:660px; object-fit:cover; object-position:center 26%; filter:saturate(.86); }
  .wood-slat { position:absolute; z-index:1; width:37px; height:100%; right:0; top:0; opacity:.65; background:repeating-linear-gradient(90deg,#543422 0px,#543422 5px,#a17a55 5px,#a17a55 9px,#3e291f 9px,#3e291f 13px); }
  .portrait-corner { position:absolute; z-index:1; bottom:2rem; left:-1px; width:110px; height:110px; border-left:5px solid var(--brass); border-bottom:5px solid var(--brass); opacity:.9; }
  .intro-strip { min-height:125px; display:flex; align-items:center; justify-content:center; gap:3rem; padding:2rem 3rem; background:#f5f3ed; }
  .intro-strip p { font:italic clamp(1.3rem,2.2vw,1.85rem) Georgia,serif; text-align:center; white-space:nowrap; }
  .woven-trim { flex:1; max-width:230px; height:11px; opacity:.78; background:repeating-linear-gradient(45deg,transparent 0,transparent 4px,var(--brass) 4px,var(--brass) 5px,transparent 5px,transparent 9px),repeating-linear-gradient(-45deg,transparent 0,transparent 4px,var(--brass) 4px,var(--brass) 5px,transparent 5px,transparent 9px); border-top:1px solid var(--brass); border-bottom:1px solid var(--brass); }
  .explore-section { padding:3rem 3rem 5.5rem; max-width:1270px; margin:auto; }
  .topic-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1.65rem; }
  .topic-card { background:#f3f0e8; color:var(--ink); text-decoration:none; transition:transform .2s,box-shadow .2s; }
  .topic-card:hover { transform:translateY(-4px); box-shadow:0 13px 30px #102b2420; }
  .topic-photo { height:210px; overflow:hidden; background:#d2c1aa; }
  .topic-photo img { width:100%; height:100%; object-fit:cover; transition:transform .3s; }
  .topic-card:hover .topic-photo img { transform:scale(1.035); }
  .topic-content { min-height:235px; display:flex; flex-direction:column; padding:1.35rem 1.55rem 1.5rem; }
  .topic-content h2 { font-size:2rem; letter-spacing:-.03em; }
  .topic-content p { line-height:1.6; color:#4d5550; font-size:.89rem; margin:.7rem 0 1rem; flex:1; }
  .topic-link { font-size:.85rem; display:flex; justify-content:space-between; width:100%; border-bottom:1px solid #b4a590; padding-bottom:.65rem; }
  .statement-section { background:linear-gradient(90deg,#0d3933f2 0%,#10463fe8 48%,#0d424da8 100%),url('/places/kerala.jpg') center 55%/cover; color:white; min-height:340px; }
  .statement-inner { max-width:1270px; margin:auto; padding:4.9rem 3rem; }
  .statement-inner p { max-width:790px; font:italic clamp(2rem,3.5vw,3.2rem)/1.22 Georgia,serif; }
  .statement-inner .gold-stroke { margin:1.4rem 0; }
  .statement-inner a { color:#fff; text-decoration:none; font-size:.89rem; }
  .writing-section { max-width:1270px; margin:auto; padding:5rem 3rem 6rem; }
  .writing-heading { display:flex; justify-content:space-between; align-items:end; gap:2rem; margin-bottom:2.3rem; }
  .writing-heading h2 { font-size:clamp(2.8rem,4vw,4.3rem); letter-spacing:-.04em; margin-top:.55rem; }
  .writing-heading>a { text-decoration:none; font-size:.87rem; color:var(--ink); border-bottom:1px solid var(--brass); padding-bottom:.5rem; }
  .posts-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1.6rem; }
  .post-card { text-decoration:none; color:var(--ink); display:flex; flex-direction:column; }
  .post-art { position:relative; height:170px; background-size:cover; background-position:center; overflow:hidden; }
  .post-art-1 { background-image:linear-gradient(135deg,#0c393550,#1a3e2a20),url('/places/kerala.jpg'); }
  .post-art-2 { background-image:linear-gradient(135deg,#0c393535,#1a3e2a20),url('/places/mthood.jpg'); }
  .post-art-3 { background-image:linear-gradient(135deg,#0c393535,#1a3e2a20),url('/places/redwoods.jpg'); }
  .post-art span { position:absolute; right:1rem; bottom:.7rem; color:#ffffffd6; font:2rem Georgia,serif; }
  .post-date { color:#936d35; letter-spacing:.1em; text-transform:uppercase; font-size:.67rem; margin:1.1rem 0 .65rem; }
  .post-card h3 { font-size:1.55rem; line-height:1.25; margin:0 0 .6rem; }
  .post-card p { color:#606760; line-height:1.65; font-size:.85rem; flex:1; }
  .post-link { margin-top:1.4rem; padding-top:.75rem; border-top:1px solid #d4cabc; font-size:.82rem; display:flex; justify-content:space-between; }
  .site-footer { background:#10444a; color:#fff; }
  .footer-main { max-width:1270px; padding:2.9rem 3rem; margin:auto; display:flex; align-items:center; justify-content:space-between; gap:2rem; }
  .footer-brand { font:2rem Georgia,serif; }
  .footer-main p { color:#d6e2d8; font-size:.84rem; margin-top:.5rem; }
  .footer-links { display:flex; gap:2rem; }
  .footer-links a { color:white; text-decoration:none; font-size:.82rem; }
  .footer-bottom { border-top:1px solid #386c68; padding:1rem 3rem 0; position:relative; min-height:45px; }
  .footer-bottom small { font-size:.7rem; color:#dfddd4; position:relative; z-index:1; }
  .footer-motif { position:absolute; bottom:0; right:0; left:0; height:12px; opacity:.6; background:radial-gradient(circle at 12px 12px,transparent 10px,var(--brass) 10.4px,var(--brass) 11.6px,transparent 12px) 0 0/24px 14px repeat-x; }
  @media(max-width:850px) { .hero-inner { min-height:auto; } .hero-copy { padding:3rem 2rem; } .hero-photo img { min-height:530px; } .intro-strip { gap:1rem; } .intro-strip p { white-space:normal; } .explore-section,.writing-section { padding-left:2rem; padding-right:2rem; } .topic-photo { height:150px; } .topic-content { padding:1rem; } }
  @media(max-width:650px) { .hero-inner { grid-template-columns:1fr; } .hero-copy { padding:3.4rem 1.4rem 3rem; } .hero-copy h1 { font-size:clamp(3rem,10vw,4.2rem); } .hero-photo { max-height:380px; } .hero-photo img { min-height:0; height:380px; } .intro-strip { padding:2rem 1.4rem; } .woven-trim { display:none; } .explore-section,.writing-section { padding:2.5rem 1.4rem 4rem; } .topic-grid,.posts-grid { grid-template-columns:1fr; } .topic-photo { height:230px; } .topic-content { min-height:180px; padding:1.2rem; } .statement-inner { padding:4rem 1.4rem; } .statement-inner p { font-size:2.15rem; } .writing-heading { align-items:start; flex-direction:column; gap:1rem; } .post-art { height:220px; } .footer-main { padding:3rem 1.4rem; flex-direction:column; align-items:start; } .footer-bottom { padding-left:1.4rem; } }
  @media(prefers-reduced-motion:reduce) { .topic-card,.topic-photo img { transition:none; } }
</style>

---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const recentPosts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const topics = [
  { number: '01', title: 'About', description: 'The work I do, the teams I lead, and the experiences behind it.', href: '/about', label: 'Get to know me' },
  { number: '02', title: 'Reflections', description: 'Thoughts on software, leadership, people, and everyday life.', href: '/reflections', label: 'Explore my writing' },
  { number: '03', title: 'Interests', description: 'Places, discoveries, and a few things I like to share.', href: '/favorites', label: 'See what I enjoy' },
];
---

<Layout title="The Good Oommen | Jinsy Oommen" description="Jinsy Oommen on technology, people, leadership, and life.">
  <div class="home">
    <section class="hero">
      <div class="hero-inner">
        <div class="hero-copy">
          <span class="eyebrow"><span class="eyebrow-line"></span> THE GOOD OOMMEN <span class="eyebrow-line"></span></span>
          <h1>Thoughts on<br /><em>work, people</em><br />&amp; everything<br />in between.</h1>
          <p>I’m Jinsy. I lead a software business, enjoy solving complex problems, and write about what I learn along the way.</p>
          <div class="hero-actions">
            <a class="primary-action" href="/reflections">Read my reflections <span aria-hidden="true">↗</span></a>
            <a class="text-action" href="/about">A little about me <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <div class="hero-visual">
          <div class="portrait-frame">
            <img src="/profile.jpg" alt="Jinsy Oommen" width="500" height="650" />
          </div>
          <div class="photo-label">A collection of ideas, experiences &amp; observations</div>
          <span class="hero-number" aria-hidden="true">01 / 03</span>
        </div>
      </div>
    </section>

    <section class="intro-strip" aria-label="About this space">
      <div class="intro-inner">
        <span class="strip-label">A PERSONAL SPACE</span>
        <p>Part professional journal. Part personal reflections. Mostly a place to share what I've been thinking about.</p>
        <a href="/about" aria-label="Read more about me">↗</a>
      </div>
    </section>

    <section class="explore-section">
      <div class="section-heading">
        <div><span class="eyebrow small">FIND YOUR WAY AROUND</span><h2>Explore the site<span class="period">.</span></h2></div>
        <p>Three different sides of the same person.</p>
      </div>
      <div class="topic-grid">
        {topics.map((topic) => (
          <a href={topic.href} class="topic-card">
            <span class="topic-number">{topic.number} /</span>
            <div>
              <h3>{topic.title}</h3>
              <p>{topic.description}</p>
            </div>
            <span class="topic-bottom">{topic.label} <span aria-hidden="true">↗</span></span>
          </a>
        ))}
      </div>
    </section>

    <section class="statement-section">
      <div class="statement-inner">
        <span class="eyebrow small light">A THOUGHT I KEEP COMING BACK TO</span>
        <p>There’s always more to learn from the people around us.</p>
        <a href="/reflections">A few things I've written <span aria-hidden="true">↗</span></a>
      </div>
      <div class="statement-decor" aria-hidden="true">“</div>
    </section>

    {recentPosts.length > 0 && (
      <section class="writing-section">
        <div class="section-heading">
          <div><span class="eyebrow small">LATEST FROM THE JOURNAL</span><h2>Recent reflections<span class="period">.</span></h2></div>
          <a class="see-all" href="/reflections">All reflections <span aria-hidden="true">↗</span></a>
        </div>
        <div class="posts-grid">
          {recentPosts.map((post, index) => (
            <a href={`/reflections/${post.id}`} class="post-card">
              <span class="post-meta">0{index + 1} <span class="rule"></span> {post.data.pubDate.toLocaleDateString('en-US', {month:'short',day:'numeric',year:'numeric'})}</span>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <span class="read-more">Read reflection <span aria-hidden="true">↗</span></span>
            </a>
          ))}
        </div>
      </section>
    )}

    <footer class="site-footer">
      <div><span class="footer-name">The Good Oommen</span><p>Thanks for stopping by.</p></div>
      <div class="footer-links"><a href="/about">About</a><a href="/reflections">Reflections</a><a href="/favorites">Interests</a></div>
      <span class="copyright">© {new Date().getFullYear()} Jinsy Oommen</span>
    </footer>
  </div>
</Layout>

<style>
  .home { --ink:#292f2b; --cream:#f7f2e9; --paper:#fffcf7; --sage:#788678; --clay:#ae6e58; color:var(--ink); overflow:hidden; }
  .hero { background:var(--cream); }
  .hero-inner { max-width:1280px; margin:auto; padding:5.4rem 3.5rem 6.5rem; display:grid; grid-template-columns:1.1fr .9fr; align-items:center; gap:5.5rem; }
  .eyebrow { display:inline-flex; align-items:center; gap:1rem; color:#816c57; font-weight:600; letter-spacing:.18em; font-size:.68rem; }
  .eyebrow-line { width:25px; height:1px; background:#aa9580; }
  h1,h2,.statement-inner p,.footer-name { font-family:Georgia,'Times New Roman',serif; }
  h1 { font-size:clamp(3.8rem,6.5vw,6.6rem); line-height:1.06; letter-spacing:-.045em; font-weight:400; margin:1.6rem 0 1.8rem; }
  h1 em { font-weight:400; color:#956f5b; }
  .hero-copy>p { font-size:1.03rem; line-height:1.85; max-width:450px; color:#54564f; }
  .hero-actions { display:flex; align-items:center; gap:2rem; margin-top:2.3rem; flex-wrap:wrap; }
  .primary-action { background:var(--ink); color:#fff; padding:1rem 1.4rem; display:inline-flex; gap:2rem; font-size:.87rem; text-decoration:none; align-items:center; }
  .primary-action:hover { background:#566458; }
  .text-action { color:var(--ink); font-size:.87rem; text-decoration:none; border-bottom:1px solid #9d9a8e; padding-bottom:.4rem; }
  .hero-visual { position:relative; max-width:480px; width:100%; justify-self:center; }
  .portrait-frame { padding:1.1rem; border:1px solid #b9b0a0; aspect-ratio: .81; background:#e8e4d9; transform:rotate(1deg); }
  .portrait-frame img { width:100%; height:100%; object-fit:cover; object-position:center 30%; filter:saturate(.75); }
  .photo-label { position:absolute; bottom:-1.5rem; left:-2.5rem; width:225px; background:#b96f54; color:#fff; padding:1.2rem 1.5rem; font-family:Georgia,serif; font-style:italic; font-size:1.15rem; line-height:1.35; }
  .hero-number { position:absolute; right:-2rem; top:-1.8rem; font-size:.7rem; letter-spacing:.17em; color:#958d7c; }
  .intro-strip { background:#e5e4d9; }
  .intro-inner { max-width:1280px; margin:auto; padding:2.6rem 3.5rem; display:grid; grid-template-columns:180px 1fr 50px; gap:2rem; align-items:center; }
  .strip-label { font-size:.65rem; letter-spacing:.16em; font-weight:700; color:#7c786a; }
  .intro-inner p { font-family:Georgia,serif; font-size:clamp(1.2rem,2vw,1.65rem); line-height:1.45; max-width:780px; }
  .intro-inner a { font-size:2rem; text-decoration:none; color:var(--ink); text-align:right; }
  .explore-section,.writing-section { padding:6rem 3.5rem 7rem; max-width:1280px; margin:auto; }
  .section-heading { display:flex; justify-content:space-between; align-items:end; gap:2rem; margin-bottom:2.5rem; }
  .section-heading h2 { font-size:clamp(2.5rem,4.2vw,4rem); font-weight:400; line-height:1.2; letter-spacing:-.03em; margin-top:.7rem; }
  .period { color:var(--clay); }
  .section-heading>p { color:#77796e; font-size:.95rem; margin-bottom:.4rem; }
  .eyebrow.small { font-size:.67rem; gap:0; }
  .topic-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1.2rem; }
  .topic-card { min-height:360px; padding:2rem 2rem 1.5rem; background:#f4f1eb; text-decoration:none; color:var(--ink); display:flex; flex-direction:column; justify-content:space-between; border-top:3px solid #b4aca0; transition:transform .2s,background .2s; }
  .topic-card:nth-child(2) { background:#e4ebe4; border-color:var(--sage); }
  .topic-card:nth-child(3) { background:#f3e7dc; border-color:var(--clay); }
  .topic-card:hover { transform:translateY(-5px); }
  .topic-number { color:#88877e; letter-spacing:.15em; font-size:.75rem; }
  .topic-card h3 { font-family:Georgia,serif; font-weight:400; font-size:2.5rem; margin-bottom:.8rem; letter-spacing:-.02em; }
  .topic-card p { line-height:1.7; color:#646860; max-width:260px; font-size:.94rem; }
  .topic-bottom { border-top:1px solid #cfcec6; padding-top:1.1rem; display:flex; justify-content:space-between; font-size:.82rem; }
  .statement-section { position:relative; background:#313c35; color:#f5f3e9; overflow:hidden; }
  .statement-inner { max-width:1280px; margin:auto; padding:6rem 3.5rem 6.5rem; position:relative; z-index:1; }
  .eyebrow.light { color:#bbbfae; }
  .statement-inner p { font-size:clamp(2.7rem,5.4vw,5rem); line-height:1.18; letter-spacing:-.025em; max-width:800px; margin:1.6rem 0 2rem; }
  .statement-inner a { color:#f3dec7; font-size:.9rem; text-decoration:none; border-bottom:1px solid #a4aaa0; padding-bottom:.5rem; }
  .statement-decor { position:absolute; right:7%; bottom:-9rem; color:#516155; font:25rem Georgia,serif; line-height:1; pointer-events:none; }
  .writing-section { background:var(--paper); max-width:none; padding-left:max(3.5rem,calc((100vw - 1280px)/2 + 3.5rem)); padding-right:max(3.5rem,calc((100vw - 1280px)/2 + 3.5rem)); }
  .see-all { font-size:.88rem; color:var(--ink); text-decoration:none; border-bottom:1px solid #aaa; padding-bottom:.5rem; }
  .posts-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1.6rem; }
  .post-card { text-decoration:none; color:var(--ink); padding:1.5rem 0; border-top:1px solid #c8c7bf; display:flex; flex-direction:column; min-height:280px; }
  .post-meta { display:flex; gap:.9rem; align-items:center; font-size:.72rem; letter-spacing:.05em; color:#8c8d80; }
  .rule { width:24px; height:1px; background:#a8a8a1; }
  .post-card h3 { font-family:Georgia,serif; font-weight:400; font-size:1.6rem; line-height:1.3; margin:1.4rem 0 .7rem; }
  .post-card p { color:#686b65; line-height:1.7; font-size:.87rem; flex:1; }
  .read-more { display:flex; justify-content:space-between; border-top:1px solid #e2e0da; padding-top:1rem; font-size:.82rem; margin-top:1.4rem; }
  .site-footer { background:#252d28; color:#f7f2e9; padding:4rem max(3.5rem,calc((100vw - 1280px)/2 + 3.5rem)) 2rem; display:grid; grid-template-columns:1fr 1fr; gap:3rem; }
  .footer-name { font-size:2rem; }
  .site-footer p { margin-top:.65rem; color:#b1b6ac; font-size:.9rem; }
  .footer-links { display:flex; gap:2rem; justify-content:flex-end; align-items:start; }
  .footer-links a { color:#f7f2e9; text-decoration:none; font-size:.86rem; }
  .copyright { grid-column:1/-1; border-top:1px solid #59615a; color:#aeb4a8; padding-top:1.3rem; font-size:.75rem; }
  @media(max-width:950px) { .hero-inner { gap:2.5rem; padding:4rem 2rem 5rem; } .photo-label { left:-1rem; } .intro-inner { padding:2rem; grid-template-columns:1fr 3fr 35px; } .explore-section,.writing-section { padding:4rem 2rem; } .statement-inner { padding:5rem 2rem; } .site-footer { padding:3rem 2rem 2rem; } }
  @media(max-width:700px) { .hero-inner { display:flex; flex-direction:column; align-items:stretch; padding:3rem 1.3rem 5rem; } h1 { font-size:clamp(3.4rem,12vw,5.5rem); } .hero-visual { width:82%; margin:2rem auto 0; } .hero-number { right:-1rem; } .photo-label { bottom:-1.8rem; left:-1rem; } .intro-inner { padding:2rem 1.3rem; grid-template-columns:1fr 28px; gap:1rem; } .strip-label { grid-column:1/-1; } .explore-section,.writing-section { padding:4rem 1.3rem; } .topic-grid,.posts-grid { grid-template-columns:1fr; } .topic-card { min-height:260px; } .section-heading { align-items:start; flex-direction:column; } .statement-inner { padding:4rem 1.3rem; } .statement-decor { right:-3rem; } .site-footer { padding:3rem 1.3rem 2rem; grid-template-columns:1fr; gap:2rem; } .footer-links { justify-content:start; } }
  @media(prefers-reduced-motion:reduce) { .topic-card,.primary-action { transition:none; } }
</style>
